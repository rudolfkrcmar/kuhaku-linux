#!/bin/sh
# Keys on the keyboard that Kūhaku answers itself: display (F7), notices (F9), talk (F10),
# apps (Super+Space: find an app and start it, like Spotlight).
f="${XDG_STATE_HOME:-$HOME/.local/state}/kuhaku/kuhaku.fifo"
case "$1" in display|notices|talk|apps) [ -p "$f" ] && echo "$1" > "$f" ;; esac
