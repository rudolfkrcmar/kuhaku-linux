[Desktop Entry]
Type=Application
Name=Miru
GenericName=Files
Comment=Your files as a calm list; everything opens in place
Exec=miru %u
Icon=space.kuhaku.Miru
Terminal=false
Categories=Utility;FileManager;Viewer;
MimeType=inode/directory;image/png;image/jpeg;image/gif;image/webp;image/svg+xml;image/bmp;image/tiff;image/heic;image/heif;image/avif;application/pdf;video/mp4;video/webm;video/x-matroska;video/quicktime;audio/mpeg;audio/ogg;audio/flac;audio/x-wav;audio/mp4;text/plain;text/markdown;model/stl;model/3mf;model/obj;
Keywords=files;folders;preview;viewer;pdf;stl;
StartupWMClass=miru.py
