#!/bin/bash
# Started at login by kuhaku-start. Sets up the keys, lock and look, and keeps Kūhaku running.
export PATH="$HOME/.local/bin:$PATH"
DIR="$(dirname "$(readlink -f "$0")")"

# When something needs your password: Kūhaku's own window (kuhaku-polkit.py). If it cannot
# run (its polkit library missing), the system's dialog, restyled in Kūhaku's look.
(
  sleep 2
  pkill -f polkit-mate-authentication-agent-1
  while :; do
    start=$(date +%s)
    python3 "$DIR/kuhaku-polkit.py"
    [ $(( $(date +%s) - start )) -lt 10 ] && break
    sleep 1
  done
  for agent in /usr/libexec/polkit-mate-authentication-agent-1 /usr/lib/x86_64-linux-gnu/polkit-mate/polkit-mate-authentication-agent-1; do
    [ -x "$agent" ] && XDG_CONFIG_HOME="$DIR/polkit-style" exec "$agent"
  done
) >/dev/null 2>&1 &

# When the keyring (saved passwords) needs your password: Kūhaku's window (kuhaku-keyring.py),
# not GNOME's grey dialog. If it is not running, D-Bus opens GNOME's prompter instead.
(
  while :; do
    start=$(date +%s)
    python3 "$DIR/kuhaku-keyring.py"
    [ $(( $(date +%s) - start )) -lt 10 ] && break
    sleep 1
  done
) >/dev/null 2>&1 &

# The lock screen: Kūhaku's own, inside the session. light-locker (older kuhaku-start versions started it)
# handed the screen to the login screen and could leave a padlock there with no way out.
if [ ! -d /run/live/medium ]; then
  (
    for _ in $(seq 1 10); do pkill -x light-locker; sleep 1; done
  ) >/dev/null 2>&1 &
  # Keep it watching; if it ever ends, start it again (an open lock simply disappears with it).
  ( while :; do python3 "$DIR/kuhaku-lock.py"; sleep 2; done ) >/dev/null 2>&1 &
fi

# Convertibles: the touch keyboard when the screen folds back, and writing with the pen.
# It stays out of the way on computers without a touch screen or pen.
if grep -qiE "touch|pen|stylus|wacom" /proc/bus/input/devices 2>/dev/null; then
  ( while :; do python3 "$DIR/kuhaku-tablet.py"; sleep 2; done ) >/dev/null 2>&1 &
fi

# No window frames: every app's minimise, close and clock are in Kūhaku's bar.
# Copied every start, so a Kūhaku update brings its theme along too.
mkdir -p "$HOME/.themes/Kuhaku" && cp -r "$DIR/system/themes/Kuhaku/." "$HOME/.themes/Kuhaku/"
xfconf-query -c xfwm4 -p /general/theme -s Kuhaku 2>/dev/null
xfconf-query -c xfwm4 -p /general/button_layout -s "|" 2>/dev/null
xfconf-query -c xfwm4 -p /general/show_dock_shadow -s false 2>/dev/null

# Keys, the settings apps read (text size, font) and the touchpad: Kūhaku's own (kuhaku-keys.py),
# in place of xfsettingsd.
( while :; do pkill -x xfsettingsd; python3 "$DIR/kuhaku-keys.py"; sleep 2; done ) >/dev/null 2>&1 &

# Notifications: Kūhaku's own cards (kuhaku-notify.py). D-Bus starts it whenever an app sends one
# (this file, read before the system's, points there), and it closes again when all is quiet.
mkdir -p "$HOME/.local/share/dbus-1/services"
printf '[D-BUS Service]\nName=org.freedesktop.Notifications\nExec=/usr/bin/python3 %s/kuhaku-notify.py\n' "$DIR" \
  > "$HOME/.local/share/dbus-1/services/org.freedesktop.Notifications.service"
dbus-send --session --type=method_call --dest=org.freedesktop.DBus / org.freedesktop.DBus.ReloadConfig 2>/dev/null
pkill -x xfce4-notifyd
python3 "$DIR/kuhaku-notify.py" >/dev/null 2>&1 &

# The screen, sleep, the lid and the battery: Kūhaku's own (kuhaku-powerd.py), in place of
# xfce4-power-manager.
( while :; do pkill -f "^xfce4-power-manager"; python3 "$DIR/kuhaku-powerd.py"; sleep 2; done ) >/dev/null 2>&1 &

# An older kuhaku-start (before the package is updated) still starts XFCE's versions of these
# three; one may come up after the loops above looked. A last sweep once things have settled.
( sleep 8; pkill -x xfsettingsd; pkill -x xfce4-notifyd; pkill -f "^xfce4-power-manager"; pkill -x light-locker ) >/dev/null 2>&1 &

# Claude's safety net: never wipe disks, delete whole folders outright, or send secrets away.
python3 "$DIR/kuhaku-guard.py" install 2>/dev/null

# The watchdog: a frozen home screen is restarted by itself (or by Ctrl+Alt+Backspace).
( while :; do "$DIR/kuhaku-watchdog"; sleep 2; done ) >/dev/null 2>&1 &

# Kūhaku's eye: the phone's camera page, for Claude (reached through Tailscale; see kuhaku-eye.py).
( while :; do python3 "$DIR/kuhaku-eye.py" serve; sleep 5; done ) >/dev/null 2>&1 &

# Dropbox and Google Drive: keep the folders chosen in Miru in sync (does nothing until some are).
( while :; do python3 "$DIR/kumo.py" daemon; sleep 30; done ) >/dev/null 2>&1 &

# The screen's size: the one chosen in Settings, or the clearest comfortable one.
python3 "$DIR/kuhaku-display" apply

# Keep Kūhaku alive; give up if it crashes repeatedly so the machine stays usable.
fails=0
while [ $fails -lt 5 ]; do
  start=$(date +%s)
  python3 "$DIR/kuhaku.py" && exit 0
  [ $(( $(date +%s) - start )) -lt 10 ] && fails=$((fails + 1)) || fails=0
  sleep 1
done
# Kūhaku keeps failing: a terminal, so the computer can still be put right.
exec "$HOME/.local/bin/kuhaku-terminal"
