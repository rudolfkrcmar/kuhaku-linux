# Kūhaku startup screen: the home screen's prompt, nothing else. The red line sits where the
# home screen's line sits; asked for the disk password, a quiet "Password" waits beside it
# and turns into dots while typing. Sizes follow the home screen (1160 px column, 26 px type).
Window.SetBackgroundTopColor(0.071, 0.071, 0.071);
Window.SetBackgroundBottomColor(0.071, 0.071, 0.071);

W = Window.GetWidth(); H = Window.GetHeight();
s = W / 2304;
if (s < 0.5) s = 0.5;
col = 1160 * s;
if (col > W - 48 * s) col = W - 48 * s;
FONT = "Inter ExtraLight " + Math.Int(20 * s);

line.image = Image("line.png").Scale(Math.Int(2 * s + 0.5), Math.Int(38 * s));
line.sprite = Sprite(line.image);
line.x = Window.GetX() + Math.Int((W - col) / 2);
line.y = Window.GetY() + Math.Int(H * 0.45 + 8 * s);
line.sprite.SetPosition(line.x, line.y, 1);
mid = line.y + line.image.GetHeight() / 2;
textx = line.x + Math.Int(18 * s);

fun progress_callback(duration, progress) { }

# Loading: the line breathes until the system is up (and while nothing is asked).
asking = 0;
t = 0;
fun refresh_callback() {
  t++;
  if (asking) { line.sprite.SetOpacity(1); return; }
  line.sprite.SetOpacity(0.3 + 0.7 * Math.Abs(Math.Sin(t / 30)));
}
Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetBootProgressFunction(progress_callback);

hint.image = Image.Text("Password", 0.6, 0.6, 0.6, 1, FONT);
hint.sprite = Sprite(hint.image);
hint.sprite.SetPosition(textx, mid - hint.image.GetHeight() / 2, 3);
hint.sprite.SetOpacity(0);
dots.sprite = Sprite();
dots.sprite.SetOpacity(0);

fun display_normal_callback() { asking = 0; hint.sprite.SetOpacity(0); dots.sprite.SetOpacity(0); }
fun display_password_callback(prompt, count) {
  asking = 1;
  if (count == 0) { dots.sprite.SetOpacity(0); hint.sprite.SetOpacity(1); return; }
  d = ""; for (i = 0; i < count; i++) d += "•";
  dots.image = Image.Text(d, 0.93, 0.93, 0.93, 1, FONT);
  dots.sprite.SetImage(dots.image);
  dots.sprite.SetPosition(textx, mid - dots.image.GetHeight() / 2, 3);
  hint.sprite.SetOpacity(0);
  dots.sprite.SetOpacity(1);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
fun message_callback(text) { }
Plymouth.SetMessageFunction(message_callback);
