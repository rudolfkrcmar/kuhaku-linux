#!/bin/sh
# Kūhaku: rebuild the MacBook8,1 speaker driver for a newly installed kernel, so a
# security update never leaves the speakers silent. Installed as
# /etc/kernel/postinst.d/zz-kuhaku-speakers (apt runs it with the new kernel's version).
# Never fails the kernel install: on any problem it logs and the old kernel stays usable.
K="${1:-$(uname -r)}"
G=/usr/local/share/kuhaku-speakers   # root-owned copy: a module built as root must not come from files the user account can change
LOG=/var/log/kuhaku-speakers.log
DEST=/lib/modules/$K/updates/mb81-speakers
exec >>"$LOG" 2>&1
echo "== $(date) kernel $K"
case "$K" in 6.12.*) ;; *) echo "not a 6.12 kernel: the patch targets 6.12, skipped"; exit 0;; esac
[ -e "/lib/modules/$K/build/Makefile" ] || { echo "no headers for $K yet (linux-headers-amd64 brings them); skipped"; exit 0; }

W=$(mktemp -d) || exit 0
trap 'rm -rf "$W"' EXIT
up=${K%%+*}; up=${up%%-*}
# The exact upstream source of this kernel; Debian's own source package as a fallback.
if wget -q -O "$W/src.tar.xz" "https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-$up.tar.xz"; then SRC="$W/src.tar.xz"
elif [ -s /usr/src/linux-source-6.12.tar.xz ]; then SRC=/usr/src/linux-source-6.12.tar.xz
else echo "no kernel source available; skipped"; exit 0; fi

mkdir "$W/b"; set --
for f in patch_cirrus.c hda_local.h hda_generic.h hda_auto_parser.h hda_jack.h hda_beep.h; do set -- "$@" "*/sound/pci/hda/$f"; done
tar -xf "$SRC" -C "$W/b" --wildcards --strip-components=4 "$@" || { echo "extract failed"; exit 0; }
patch -s -p4 -d "$W/b" < "$G/mb81-speakers.patch" || { echo "patch does not apply to $K; speakers need a manual look"; exit 0; }
cp "$G/Makefile" "$W/b/Makefile"
make -C "/lib/modules/$K/build" M="$W/b" modules >"$W/build.log" 2>&1 || { tail -20 "$W/build.log"; echo "build failed"; exit 0; }
grep -aq "MacBook8,1 speakers: codec clock" "$W/b/snd-hda-codec-cirrus.ko" || { echo "built module lacks the speaker code"; exit 0; }
install -d "$DEST"
install -m 0644 "$W/b/snd-hda-codec-cirrus.ko" "$DEST/snd-hda-codec-cirrus.ko"
depmod -a "$K"
echo "installed $DEST/snd-hda-codec-cirrus.ko"
exit 0
