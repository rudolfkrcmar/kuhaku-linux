#!/bin/sh
# Kūhaku's quiet power savings, run at boot and whenever a device appears.
# Lets idle parts of the computer sleep (PCI devices, and USB devices that are not
# keyboards, mice, touch or pens), and wakes the processor less often.
# Every step is allowed to fail: an odd device must never stop the computer.
echo 0 > /proc/sys/kernel/nmi_watchdog 2>/dev/null
echo 1500 > /proc/sys/vm/dirty_writeback_centisecs 2>/dev/null
for d in /sys/bus/pci/devices/*; do
  [ -w "$d/power/control" ] && echo auto > "$d/power/control" 2>/dev/null
done
for d in /sys/bus/usb/devices/*; do
  [ -w "$d/power/control" ] || continue
  # Hands on the computer stay awake: input devices (USB class 03) answer at once.
  grep -qs '^03$' "$d"/*/bInterfaceClass && continue
  echo 2000 > "$d/power/autosuspend_delay_ms" 2>/dev/null
  echo auto > "$d/power/control" 2>/dev/null
done
[ -w /sys/module/snd_hda_intel/parameters/power_save ] && echo 1 > /sys/module/snd_hda_intel/parameters/power_save 2>/dev/null
exit 0
