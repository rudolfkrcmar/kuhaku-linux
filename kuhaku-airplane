#!/usr/bin/env python3
"""Airplane mode (F8): every radio off, or all back on. Kūhaku shows which."""
import json, os, struct, time
from pathlib import Path

def radios():
    return {p.name: (p / "soft").read_text().strip() == "1" for p in Path("/sys/class/rfkill").glob("rfkill*")}

before = radios()
time.sleep(0.25)
after = radios()
if after == before:   # the system did not already toggle them from the key itself
    block = not all(after.values()) if after else True
    # struct rfkill_event: idx u32, type u8 (0 = all), op u8 (3 = change all), soft u8, hard u8
    with open("/dev/rfkill", "wb", buffering=0) as f:
        f.write(struct.pack("IBBBB", 0, 0, 3, int(block), 0))
    time.sleep(0.2)
    after = radios()
on = bool(after) and all(after.values())
fifo = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "kuhaku" / "kuhaku.fifo"
if fifo.is_fifo():
    with open(fifo, "w") as f:
        f.write("note " + json.dumps({"title": "Airplane mode", "detail": "On, all radios off" if on else "Off, Wi‑Fi and Bluetooth back"}) + "\n")
